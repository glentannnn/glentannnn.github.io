---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProjectModal from "../components/ProjectModal.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base>
  <section class="hero wrap">
    <h1>Glen Tan builds small, useful things for the web.</h1>
    <p>Selected projects, experiments and apps. Open any project to try a live preview.</p>
  </section>

  <section id="work" class="work wrap" aria-labelledby="work-title">
    <h2 id="work-title" class="label">Selected work · {projects.length}</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="about" class="split wrap" aria-labelledby="about-title">
    <h2 id="about-title" class="label">About</h2>
    <div class="prose">
      <p>Write a short introduction here: who you are, what you like building and what you're learning next.</p>
      <p>Two or three sentences is plenty. The projects do the rest of the talking.</p>
    </div>
  </section>

  <section id="contact" class="split wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="label">Contact</h2>
    <div class="prose">
      <p>The best way to reach me is by email at <span class="mono">glen.tanyonghao@gmail.com</span>.</p>
      <p><a href="https://github.com/glentannnn" target="_blank" rel="noopener">GitHub</a> · <a href="https://www.linkedin.com/in/glen-tan-yong-hao" target="_blank" rel="noopener">LinkedIn</a></p>
    </div>
  </section>

  {projects.map((project) => <ProjectModal project={project} />)}
</Base>

<style>
  .hero { padding-block: clamp(48px, 9vw, 120px) clamp(40px, 6vw, 72px); display: grid; gap: 18px; }
  .hero h1 { font-size: var(--step-3); font-weight: 500; letter-spacing: -0.035em; line-height: 1.02; max-width: 16ch; }
  .hero p { color: var(--muted); max-width: 46ch; font-size: var(--step-1); }

  .work { display: grid; gap: 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 40px 28px; }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 16px 28px;
    margin-top: 96px;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
  }
  @media (max-width: 700px) { .split { grid-template-columns: minmax(0, 1fr); } }

  :global(html:has(dialog[open])) { overflow: hidden; }
</style>

<script>
  // Card clicks open the popup; the URL hash (#project-id) keeps popups shareable.
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>("dialog.project-modal").forEach((d) => {
    dialogs.set(d.dataset.project!, d);
  });

  function open(id: string) {
    const dialog = dialogs.get(id);
    if (!dialog) return;
    dialogs.forEach((d) => d.open && d !== dialog && d.close());
    // Load the interactive preview only when the popup first opens.
    dialog.querySelectorAll<HTMLIFrameElement>("iframe[data-src]").forEach((f) => {
      if (!f.getAttribute("src")) f.src = f.dataset.src!;
    });
    if (!dialog.open) dialog.showModal();
    if (location.hash !== `#${id}`) history.pushState(null, "", `#${id}`);
  }

  function clearHash() {
    if (location.hash && dialogs.has(location.hash.slice(1))) {
      history.pushState(null, "", location.pathname + location.search);
    }
  }

  document.querySelectorAll<HTMLAnchorElement>("a[data-project]").forEach((link) => {
    link.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // let "open in new tab" work
      e.preventDefault();
      open(link.dataset.project!);
    });
  });

  dialogs.forEach((dialog) => {
    dialog.addEventListener("click", (e) => {
      // A click on the backdrop lands on the <dialog> itself.
      if (e.target === dialog || (e.target as Element).closest("[data-close]")) dialog.close();
    });
    dialog.addEventListener("close", clearHash); // covers Esc, the × button and the backdrop
  });

  function syncFromHash() {
    const id = location.hash.slice(1);
    if (dialogs.has(id)) open(id);
    else dialogs.forEach((d) => d.open && d.close());
  }
  window.addEventListener("popstate", syncFromHash);
  syncFromHash();
</script>
